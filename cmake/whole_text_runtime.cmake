function(koefude_wt_regular path basename)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "Whole text runtime requires an absolute regular local file")
    endif()
    if("${path}" MATCHES "^[/\\\\]{2}")
        message(FATAL_ERROR "Whole text runtime rejects network/device paths")
    endif()
    # 最終fileだけでなく祖先のjunction/symlinkも読込み前に拒否します。
    get_filename_component(ancestor "${path}" DIRECTORY)
    while(NOT ancestor STREQUAL "")
        if(IS_SYMLINK "${ancestor}")
            message(FATAL_ERROR "Whole text runtime rejects reparse ancestors")
        endif()
        get_filename_component(next_ancestor "${ancestor}" DIRECTORY)
        if(next_ancestor STREQUAL ancestor)
            break()
        endif()
        set(ancestor "${next_ancestor}")
    endwhile()
    get_filename_component(name "${path}" NAME)
    if(NOT name STREQUAL basename)
        message(FATAL_ERROR "Whole text runtime basename mismatch")
    endif()
endfunction()

function(koefude_wt_contract variant)
    if(variant STREQUAL "portable")
        set(_wt_dll KoeFude.WholeText.dll PARENT_SCOPE)
        set(_wt_receipt KoeFude.WholeText.runtime.json PARENT_SCOPE)
        set(_wt_cpu static-crt-portable-cpu-no-native-no-openmp-no-gpu-v1 PARENT_SCOPE)
        set(_wt_schema 1 PARENT_SCOPE)
    elseif(variant STREQUAL "avx2-norepack")
        set(_wt_dll KoeFude.WholeText.Avx2NoRepack.dll PARENT_SCOPE)
        set(_wt_receipt KoeFude.WholeText.Avx2NoRepack.runtime.json PARENT_SCOPE)
        set(_wt_cpu static-crt-avx2-norepack-cpu-no-native-no-openmp-no-gpu-v1 PARENT_SCOPE)
        set(_wt_schema 2 PARENT_SCOPE)
    elseif(variant STREQUAL "ministral14b-avx2-norepack")
        set(_wt_dll KoeFude.WholeText.Ministral14B.Avx2NoRepack.dll PARENT_SCOPE)
        set(_wt_receipt KoeFude.WholeText.Ministral14B.Avx2NoRepack.runtime.json PARENT_SCOPE)
        set(_wt_cpu static-crt-avx2-norepack-cpu-no-native-no-openmp-no-gpu-v1 PARENT_SCOPE)
        set(_wt_schema 3 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unknown product whole text variant")
    endif()
endfunction()

function(koefude_wt_validate runtime license configuration)
    set(variant portable)
    if(ARGC GREATER 3)
        set(variant "${ARGV3}")
    endif()
    koefude_wt_contract("${variant}")
    if(variant STREQUAL "ministral14b-avx2-norepack" AND
       (NOT WT_ACCOUNTING_V2 OR NOT WT_CAPABILITIES_MASK STREQUAL "3"))
        message(FATAL_ERROR "Ministral requires exact V2 generation capability3 receipt")
    endif()
    koefude_wt_regular("${runtime}" "${_wt_dll}")
    koefude_wt_regular("${license}" "LICENSE")
    get_filename_component(parent "${runtime}" DIRECTORY)
    set(receipt "${parent}/${_wt_receipt}")
    koefude_wt_regular("${receipt}" "${_wt_receipt}")
    # CRLFのtext読取りで短くなる文字列長をraw容量の上限判定へ使いません。
    file(SIZE "${receipt}" json_bytes)
    if(json_bytes GREATER 8192)
        message(FATAL_ERROR "Whole text receipt is oversized")
    endif()
    file(READ "${receipt}" json LIMIT 8193)
    file(SHA256 "${runtime}" dll_sha)
    file(SIZE "${runtime}" dll_bytes)
    file(SHA256 "${license}" license_sha)
    if(NOT license_sha STREQUAL _wt_license)
        message(FATAL_ERROR "Whole text fixed MIT license mismatch")
    endif()
    set(fields schema configuration architecture engine_commit engine_tree header_sha256 cpu_contract license_sha256 dll_name dll_bytes dll_sha256)
    set(expected "${_wt_schema}" "${configuration}" x64 "${_wt_commit}" "${_wt_tree}" "${_wt_header}" "${_wt_cpu}" "${license_sha}" "${_wt_dll}" "${dll_bytes}" "${dll_sha}")
    if(variant STREQUAL "avx2-norepack" OR variant STREQUAL "ministral14b-avx2-norepack")
        list(APPEND fields variant cpu_repack required_features_mask xcr0_mask abi_version)
        list(APPEND expected "${variant}" OFF 32767 6 1)
    endif()
    # ADR1284: schema3を明示した計数用/後続製品用にだけ要求します。
    if(WT_ACCOUNTING_V2)
        file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/inference/whole_text_native_abi.h" abi_header_sha)
        if(NOT WT_CAPABILITIES_MASK STREQUAL "1" AND NOT WT_CAPABILITIES_MASK STREQUAL "3")
            message(FATAL_ERROR "Unknown or missing V2 capability mask")
        endif()
        if(NOT DEFINED WT_REQUIRED_CAPABILITIES_MASK)
            set(WT_REQUIRED_CAPABILITIES_MASK 1)
        endif()
        if(NOT WT_REQUIRED_CAPABILITIES_MASK STREQUAL "1" AND NOT WT_REQUIRED_CAPABILITIES_MASK STREQUAL "3")
            message(FATAL_ERROR "Unknown required V2 capability mask")
        endif()
        math(EXPR accepted_mask "${WT_CAPABILITIES_MASK} & ${WT_REQUIRED_CAPABILITIES_MASK}")
        if(NOT accepted_mask EQUAL WT_REQUIRED_CAPABILITIES_MASK)
            message(FATAL_ERROR "V2 capability is insufficient")
        endif()
        list(REMOVE_AT expected 0)
        list(PREPEND expected 3)
        if(variant STREQUAL "portable")
            list(APPEND fields variant cpu_repack required_features_mask xcr0_mask abi_version)
            list(APPEND expected portable ON 0 0 2)
        else()
            list(POP_BACK expected)
            list(APPEND expected 2)
        endif()
        list(APPEND fields capabilities_mask accounting_contract plan_contract session_contract abi_header_sha256)
        list(APPEND expected "${WT_CAPABILITIES_MASK}" 2 2 2 "${abi_header_sha}")
    endif()
    list(LENGTH fields field_count)
    string(JSON member_count ERROR_VARIABLE error LENGTH "${json}")
    if(error OR NOT member_count EQUAL field_count)
        message(FATAL_ERROR "Whole text receipt schema fields mismatch")
    endif()
    if(variant STREQUAL "avx2-norepack" OR variant STREQUAL "ministral14b-avx2-norepack" OR WT_ACCOUNTING_V2)
        string(REGEX MATCHALL "\"[a-z0-9_]+\"[ \t\r\n]*:" raw_keys "${json}")
        list(LENGTH raw_keys raw_key_count)
        if(NOT raw_key_count EQUAL field_count)
            message(FATAL_ERROR "Whole text receipt duplicate or escaped key rejected")
        endif()
    endif()
    math(EXPR last "${field_count} - 1")
    foreach(index RANGE 0 ${last})
        list(GET fields ${index} field)
        list(GET expected ${index} wanted)
        string(JSON actual ERROR_VARIABLE error GET "${json}" "${field}")
        if(error OR NOT actual STREQUAL wanted)
            message(FATAL_ERROR "Whole text receipt mismatch: ${field}")
        endif()
        string(JSON kind ERROR_VARIABLE error TYPE "${json}" "${field}")
        if(field MATCHES "^(schema|dll_bytes|required_features_mask|xcr0_mask|abi_version|capabilities_mask|accounting_contract|plan_contract|session_contract)$")
            if(error OR NOT kind STREQUAL "NUMBER")
                message(FATAL_ERROR "Whole text receipt numeric field type mismatch")
            endif()
        elseif(field STREQUAL "cpu_repack")
            if(error OR NOT kind STREQUAL "BOOLEAN")
                message(FATAL_ERROR "Whole text receipt bool field type mismatch")
            endif()
        elseif(error OR NOT kind STREQUAL "STRING")
            message(FATAL_ERROR "Whole text receipt string field type mismatch")
        endif()
    endforeach()
    file(SHA256 "${receipt}" receipt_sha)
    set(WT_VALIDATED_RECEIPT_SHA "${receipt_sha}" PARENT_SCOPE)
    set(WT_VALIDATED_RECEIPT_BYTES "${json_bytes}" PARENT_SCOPE)
    set(WT_VALIDATED_RECEIPT_PATH "${receipt}" PARENT_SCOPE)
    set(WT_VALIDATED_DLL_BYTES "${dll_bytes}" PARENT_SCOPE)
    set(WT_VALIDATED_DLL_SHA "${dll_sha}" PARENT_SCOPE)
    set(WT_VALIDATED_LICENSE_SHA "${license_sha}" PARENT_SCOPE)
    set(WT_VALIDATED_RECEIPT "${json}" PARENT_SCOPE)
endfunction()

if(DEFINED WT_MODE)
    if(NOT DEFINED WT_VARIANT)
        set(WT_VARIANT portable)
    endif()
    koefude_wt_contract("${WT_VARIANT}")
    if(WT_VARIANT STREQUAL "ministral14b-avx2-norepack" AND NOT WT_ACCOUNTING_V2)
        message(FATAL_ERROR "Ministral producer requires V2")
    endif()
    koefude_wt_regular("${WT_RUNTIME}" "${_wt_dll}")
    koefude_wt_regular("${WT_LICENSE}" "LICENSE")
    if(NOT WT_CONFIG STREQUAL "Debug" AND NOT WT_CONFIG STREQUAL "Release")
        message(FATAL_ERROR "Whole text receipt requires actual Debug or Release configuration")
    endif()
    get_filename_component(parent "${WT_RUNTIME}" DIRECTORY)
    if(WT_MODE STREQUAL "GENERATE")
        # 新model契約は計数専用bit1へ縮小したreceiptを生成しません。
        if(WT_VARIANT STREQUAL "ministral14b-avx2-norepack" AND
           (NOT WT_ACCOUNTING_V2 OR NOT WT_CAPABILITIES_MASK STREQUAL "3"))
            message(FATAL_ERROR "Ministral producer requires V2 generation capability3")
        endif()
        # この入口は独立targetのPOST_BUILDだけから実configと検証済みpinを受け取ります。
        if(NOT WT_ARCH STREQUAL "x64" OR NOT WT_COMMIT STREQUAL _wt_commit OR
           NOT WT_TREE STREQUAL _wt_tree OR NOT WT_HEADER STREQUAL _wt_header OR NOT WT_CPU STREQUAL _wt_cpu)
            message(FATAL_ERROR "Whole text producer pin mismatch")
        endif()
        file(SHA256 "${WT_RUNTIME}" dll_sha)
        file(SIZE "${WT_RUNTIME}" dll_bytes)
        file(SHA256 "${WT_LICENSE}" license_sha)
        if(NOT license_sha STREQUAL _wt_license)
            message(FATAL_ERROR "Whole text producer fixed MIT license mismatch")
        endif()
        file(WRITE "${parent}/${_wt_receipt}"
            "{\n  \"schema\": ${_wt_schema},\n  \"configuration\": \"${WT_CONFIG}\",\n  \"architecture\": \"x64\",\n  \"engine_commit\": \"${_wt_commit}\",\n  \"engine_tree\": \"${_wt_tree}\",\n  \"header_sha256\": \"${_wt_header}\",\n  \"cpu_contract\": \"${_wt_cpu}\",\n  \"license_sha256\": \"${license_sha}\",\n  \"dll_name\": \"${_wt_dll}\",\n  \"dll_bytes\": ${dll_bytes},\n  \"dll_sha256\": \"${dll_sha}\"\n}\n")
        if(WT_VARIANT STREQUAL "avx2-norepack" OR WT_VARIANT STREQUAL "ministral14b-avx2-norepack")
            file(READ "${parent}/${_wt_receipt}" generated)
            string(JSON generated SET "${generated}" variant "\"${WT_VARIANT}\"")
            string(JSON generated SET "${generated}" cpu_repack false)
            string(JSON generated SET "${generated}" required_features_mask 32767)
            string(JSON generated SET "${generated}" xcr0_mask 6)
            string(JSON generated SET "${generated}" abi_version 1)
            file(WRITE "${parent}/${_wt_receipt}" "${generated}\n")
        endif()
        # U2 companionは計数bitだけです。未実装の生成bitを宣言しません。
        if(WT_ACCOUNTING_V2)
            file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/../src/inference/whole_text_native_abi.h" abi_header_sha)
            if((NOT WT_CAPABILITIES_MASK STREQUAL "1" AND NOT WT_CAPABILITIES_MASK STREQUAL "3") OR NOT WT_ABI_HEADER_SHA256 STREQUAL abi_header_sha)
                message(FATAL_ERROR "V2 producer capability/header mismatch")
            endif()
            file(READ "${parent}/${_wt_receipt}" generated)
            string(JSON generated SET "${generated}" schema 3)
            string(JSON generated SET "${generated}" variant "\"${WT_VARIANT}\"")
            if(WT_VARIANT STREQUAL "portable")
                string(JSON generated SET "${generated}" cpu_repack true)
                string(JSON generated SET "${generated}" required_features_mask 0)
                string(JSON generated SET "${generated}" xcr0_mask 0)
            endif()
            string(JSON generated SET "${generated}" abi_version 2)
            string(JSON generated SET "${generated}" capabilities_mask ${WT_CAPABILITIES_MASK})
            string(JSON generated SET "${generated}" accounting_contract 2)
            string(JSON generated SET "${generated}" plan_contract 2)
            string(JSON generated SET "${generated}" session_contract 2)
            string(JSON generated SET "${generated}" abi_header_sha256 "\"${abi_header_sha}\"")
            file(WRITE "${parent}/${_wt_receipt}" "${generated}\n")
        endif()
    elseif(WT_MODE STREQUAL "VALIDATE")
        koefude_wt_validate("${WT_RUNTIME}" "${WT_LICENSE}" "${WT_CONFIG}" "${WT_VARIANT}")
    elseif(WT_MODE STREQUAL "STAGE")
        koefude_wt_validate("${WT_RUNTIME}" "${WT_LICENSE}" "${WT_CONFIG}" "${WT_VARIANT}")
        if(NOT IS_ABSOLUTE "${WT_DEST}" OR "${WT_DEST}" MATCHES "^[/\\\\]{2}" OR IS_SYMLINK "${WT_DEST}")
            message(FATAL_ERROR "Whole text stage requires a local absolute directory")
        endif()
        # 旧slotを触る前に全copyとpost-copy pin照合を専用一時folderで終えます。
        string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef stage_id)
        set(incoming "${WT_DEST}/.whole-text-${stage_id}")
        file(MAKE_DIRECTORY "${incoming}/licenses")
        file(COPY_FILE "${WT_RUNTIME}" "${incoming}/${_wt_dll}" RESULT copy_dll)
        file(COPY_FILE "${WT_LICENSE}" "${incoming}/licenses/llama.cpp-LICENSE.txt" RESULT copy_license)
        # LF/CRLFを再renderせず、検証した元receiptの全byteを保持します。
        file(COPY_FILE "${WT_VALIDATED_RECEIPT_PATH}" "${incoming}/${_wt_receipt}" RESULT copy_receipt)
        if(copy_dll OR copy_license OR copy_receipt)
            file(REMOVE_RECURSE "${incoming}")
            message(FATAL_ERROR "Whole text staged copy failed before replacement")
        endif()
        file(SHA256 "${incoming}/${_wt_dll}" staged_sha)
        file(SHA256 "${incoming}/licenses/llama.cpp-LICENSE.txt" staged_license_sha)
        file(SHA256 "${incoming}/${_wt_receipt}" staged_receipt_sha)
        file(SIZE "${incoming}/${_wt_receipt}" staged_receipt_bytes)
        if(NOT WT_VALIDATED_DLL_SHA STREQUAL staged_sha OR
           NOT WT_VALIDATED_LICENSE_SHA STREQUAL staged_license_sha OR
           NOT WT_VALIDATED_RECEIPT_SHA STREQUAL staged_receipt_sha OR
           NOT WT_VALIDATED_RECEIPT_BYTES EQUAL staged_receipt_bytes)
            file(REMOVE_RECURSE "${incoming}")
            message(FATAL_ERROR "Whole text post-copy hash mismatch")
        endif()
        file(TO_CMAKE_PATH "${WT_RUNTIME}" inventory_source)
        file(SIZE "${WT_LICENSE}" inventory_license_bytes)
        file(SIZE "${incoming}/${_wt_receipt}" inventory_receipt_bytes)
        get_filename_component(inventory_parent "${inventory_source}" DIRECTORY)
        file(TO_CMAKE_PATH "${WT_LICENSE}" inventory_license_source)
        file(WRITE "${incoming}/${_wt_receipt}.inventory.json"
            "{\"variant\":\"${WT_VARIANT}\",\"configuration\":\"${WT_CONFIG}\",\"cpu_contract\":\"${_wt_cpu}\",\"source\":\"${inventory_source}\",\"dll_bytes\":${WT_VALIDATED_DLL_BYTES},\"dll_sha256\":\"${WT_VALIDATED_DLL_SHA}\",\"receipt_sha256\":\"${WT_VALIDATED_RECEIPT_SHA}\",\"license_sha256\":\"${WT_VALIDATED_LICENSE_SHA}\",\"files\":[{\"name\":\"${_wt_dll}\",\"source\":\"${inventory_source}\",\"bytes\":${WT_VALIDATED_DLL_BYTES},\"sha256\":\"${WT_VALIDATED_DLL_SHA}\"},{\"name\":\"${_wt_receipt}\",\"source\":\"${inventory_parent}/${_wt_receipt}\",\"bytes\":${inventory_receipt_bytes},\"sha256\":\"${WT_VALIDATED_RECEIPT_SHA}\"},{\"name\":\"licenses/llama.cpp-LICENSE.txt\",\"source\":\"${inventory_license_source}\",\"bytes\":${inventory_license_bytes},\"sha256\":\"${WT_VALIDATED_LICENSE_SHA}\"}]}\n")
        file(MAKE_DIRECTORY "${WT_DEST}/licenses" "${incoming}/backup/licenses")
        set(committed)
        set(backed_up)
        set(commit_failure "")
        set(slot_files "${_wt_dll}" "${_wt_receipt}" "${_wt_receipt}.inventory.json" "licenses/llama.cpp-LICENSE.txt")
        foreach(name IN LISTS slot_files)
            if(EXISTS "${WT_DEST}/${name}")
                file(RENAME "${WT_DEST}/${name}" "${incoming}/backup/${name}" RESULT moved)
                if(moved)
                    set(commit_failure "${moved}")
                    break()
                endif()
                list(APPEND backed_up "${name}")
            endif()
            file(RENAME "${incoming}/${name}" "${WT_DEST}/${name}" RESULT moved)
            if(moved)
                set(commit_failure "${moved}")
                break()
            endif()
            list(APPEND committed "${name}")
        endforeach()
        if(commit_failure)
            # 置換途中の失敗も旧slot全fileへ戻します。更新しないslotは対象にしません。
            foreach(name IN LISTS committed)
                file(REMOVE "${WT_DEST}/${name}")
            endforeach()
            foreach(name IN LISTS backed_up)
                file(RENAME "${incoming}/backup/${name}" "${WT_DEST}/${name}" RESULT restored)
                if(restored)
                    message(FATAL_ERROR "Whole text rollback requires preserved backup: ${incoming}")
                endif()
            endforeach()
            file(REMOVE_RECURSE "${incoming}")
            message(FATAL_ERROR "Whole text slot replacement failed; previous files restored")
        endif()
        # 最終配置の全pinも照合します。検証済み一時copyと同一byteです。
        file(SHA256 "${WT_DEST}/${_wt_dll}" final_dll_sha)
        file(SHA256 "${WT_DEST}/${_wt_receipt}" final_receipt_sha)
        file(SIZE "${WT_DEST}/${_wt_receipt}" final_receipt_bytes)
        file(SHA256 "${WT_DEST}/licenses/llama.cpp-LICENSE.txt" final_license_sha)
        if(NOT final_dll_sha STREQUAL WT_VALIDATED_DLL_SHA OR
           NOT final_receipt_sha STREQUAL WT_VALIDATED_RECEIPT_SHA OR
           NOT final_receipt_bytes EQUAL WT_VALIDATED_RECEIPT_BYTES OR
           NOT final_license_sha STREQUAL WT_VALIDATED_LICENSE_SHA)
            foreach(name IN LISTS committed)
                file(REMOVE "${WT_DEST}/${name}")
            endforeach()
            foreach(name IN LISTS backed_up)
                file(RENAME "${incoming}/backup/${name}" "${WT_DEST}/${name}" RESULT restored)
                if(restored)
                    message(FATAL_ERROR "Whole text final rollback requires preserved backup: ${incoming}")
                endif()
            endforeach()
            file(REMOVE_RECURSE "${incoming}")
            message(FATAL_ERROR "Whole text final post-copy pin mismatch; previous files restored")
        endif()
        file(REMOVE_RECURSE "${incoming}")
    else()
        message(FATAL_ERROR "Unknown whole text runtime mode")
    endif()
endif()
