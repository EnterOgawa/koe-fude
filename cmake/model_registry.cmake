# 単一固定lockのモデル・取得・ASR定義を生成します。
# 1.0.0 Shunji Ogawa 2026/11/11 ADR1410の生成C++識別子だけを明示mappingへ分離。
# 0.1.0 Shunji Ogawa 2026/10/19 local全文用途と隔離script検証を追加。
# 0.1.0 Shunji Ogawa 2026/10/20 用途13の専用取得scopeを検査。
function(koefude_generate_model_registry manifest_path output_path)
    file(READ "${manifest_path}" model_manifest)
    string(JSON model_count LENGTH "${model_manifest}" models)
    string(JSON model_schema GET "${model_manifest}" schema_version)
    if(NOT model_count EQUAL 15 OR NOT model_schema EQUAL 1)
        message(FATAL_ERROR "Unsupported model registry schema or model count")
    endif()
    set(model_ids whisper-large-v3-turbo-q8 pyannote-segmentation-3-fp32 campplus-zh-en-common-advanced
        whisper-large-v3-fp16 silero-vad-6.2.0 kotoba-whisper-v2-fp16 kotoba-whisper-v2-q5
        parakeet-ja-ctc-int8 parakeet-ja-tokens parakeet-ja-ctc-fp32 parakeet-ja-ctc-fp32-data
        rinna-japanese-gpt2-small-fp32 rinna-japanese-gpt2-small-tokenizer gemma-4-31b-it-qat-q4-0-gguf
        ministral-3-14b-instruct-2512-q4-k-m-gguf)
    string(JSON whole_role_count LENGTH "${model_manifest}" whole_text_roles)
    string(JSON whole_role GET "${model_manifest}" whole_text_roles native_cpu)
    string(JSON whole_role_16gb GET "${model_manifest}" whole_text_roles native_cpu_16gb)
    if(NOT whole_role_count EQUAL 2 OR NOT whole_role STREQUAL "13" OR NOT whole_role_16gb STREQUAL "14")
        message(FATAL_ERROR "Invalid dedicated whole-text model role")
    endif()
    set(ROLE_WHOLE_TEXT_NATIVE "${whole_role}")
    set(ROLE_WHOLE_TEXT_NATIVE_16GB "${whole_role_16gb}")
    # 用途scopeは専用13だけに許し、旧local flagとの混在を拒否します。
    foreach(local_index RANGE 0 14)
        string(JSON old_type ERROR_VARIABLE old_error TYPE "${model_manifest}" models ${local_index} local_verification_only)
        string(JSON scope_type ERROR_VARIABLE scope_error TYPE "${model_manifest}" models ${local_index} acquisition_scope)
        if(NOT old_error)
            message(FATAL_ERROR "Obsolete local verification flag is not supported")
        endif()
        if(local_index EQUAL 13 OR local_index EQUAL 14)
            string(JSON scope_value GET "${model_manifest}" models ${local_index} acquisition_scope)
            if(NOT scope_type STREQUAL "STRING" OR NOT scope_value STREQUAL "whole_text")
                message(FATAL_ERROR "Whole-text acquisition requires its dedicated scope")
            endif()
        elseif(NOT scope_error)
            message(FATAL_ERROR "Acquisition scope is reserved for whole-text13")
        endif()
    endforeach()
    set(MODEL_COUNT ${model_count})
    set(MODEL_ENTRIES "")
    set(ASR_COUNT 0)
    set(ASR_ENTRIES "")
    set(asr_pairs "")
    # 固定metadata表記と生成C++識別子を分離し、保存値やregistry値を変更しない。
    set(cpp_family_Whisper WHISPER)
    set(cpp_family_Kotoba KOTOBA)
    set(cpp_family_Parakeet PARAKEET)
    set(cpp_family_OpenAiAudio OPEN_AI_AUDIO)
    set(cpp_profile_Quality QUALITY)
    set(cpp_profile_Standard STANDARD)
    set(cpp_engine_WhisperCpp WHISPER_CPP)
    set(cpp_engine_ParakeetCtc PARAKEET_CTC)
    set(cpp_engine_OpenAiTranscriptions OPEN_AI_TRANSCRIPTIONS)
    foreach(index RANGE 0 14)
        string(JSON model_id GET "${model_manifest}" models ${index} id)
        list(GET model_ids ${index} expected_id)
        if(NOT model_id STREQUAL expected_id)
            message(FATAL_ERROR "Model registry roles do not match the native engine interface")
        endif()
        foreach(field id file sha256 size revision)
            string(JSON value GET "${model_manifest}" models ${index} ${field})
            string(TOUPPER "${field}" upper_field)
            set(MODEL_${index}_${upper_field} "${value}")
        endforeach()
        string(APPEND MODEL_ENTRIES "    {\"${MODEL_${index}_ID}\", L\"${MODEL_${index}_FILE}\", \"${MODEL_${index}_SHA256}\", ${MODEL_${index}_SIZE}ULL, \"${MODEL_${index}_REVISION}\"},\n")
        string(JSON asr_type ERROR_VARIABLE asr_error TYPE "${model_manifest}" models ${index} asr)
        # 比較専用LMを製品のASR選択肢や通常取得へ誤接続しない。
        if(index EQUAL 11 OR index EQUAL 12)
            string(JSON comparison_only GET "${model_manifest}" models ${index} comparison_only)
            if(NOT comparison_only OR NOT asr_error)
                message(FATAL_ERROR "Japanese LM assets must remain comparison-only without ASR routing")
            endif()
        endif()
        if(NOT asr_error)
            foreach(field family profile family_resource choice_resource result_resource japanese_only gpu_bytes gpu_validated history_tokens vad_threshold_milli vad_silence_ms vad_padding_ms engine tokens_model frame_ms vad_gain external_data_model)
                string(JSON asr_${field} GET "${model_manifest}" models ${index} asr ${field})
            endforeach()
            if(NOT asr_family MATCHES "^(Whisper|Kotoba|Parakeet)$" OR NOT asr_profile MATCHES "^(Quality|Standard)$")
                message(FATAL_ERROR "Unknown ASR model/profile")
            endif()
            if(asr_history_tokens LESS 0 OR asr_history_tokens GREATER 224)
                message(FATAL_ERROR "ASR history exceeds the validated token budget")
            endif()
            if(asr_engine STREQUAL "ParakeetCtc")
                if(NOT asr_family STREQUAL "Parakeet" OR NOT asr_tokens_model EQUAL 8 OR
                   NOT asr_frame_ms EQUAL 80 OR asr_gpu_bytes LESS 1 OR
                   asr_gpu_bytes GREATER 12884901888)
                    message(FATAL_ERROR "Invalid CTC model contract")
                endif()
                set(asr_tokens_value "ModelId::PARAKEET_TOKENS")
            elseif(asr_engine STREQUAL "WhisperCpp")
                if(asr_family STREQUAL "Parakeet" OR NOT asr_tokens_model EQUAL -1 OR
                   NOT asr_frame_ms EQUAL 0)
                    message(FATAL_ERROR "Invalid Whisper model contract")
                endif()
                set(asr_tokens_value "std::nullopt")
            else()
                message(FATAL_ERROR "Unsupported native ASR engine")
            endif()
            if(asr_external_data_model EQUAL -1)
                set(asr_external_value "std::nullopt")
            elseif(asr_external_data_model EQUAL 10 AND index EQUAL 9 AND
                   asr_engine STREQUAL "ParakeetCtc")
                set(asr_external_value "ModelId::PARAKEET_FLOAT_DATA")
            else()
                message(FATAL_ERROR "Invalid external weight dependency")
            endif()
            foreach(field vad_threshold_milli vad_silence_ms vad_padding_ms)
                if(NOT asr_${field} MATCHES "^[0-9]+$")
                    message(FATAL_ERROR "ASR VAD settings must be non-negative integer units")
                endif()
            endforeach()
            if(asr_vad_threshold_milli LESS 1 OR asr_vad_threshold_milli GREATER 999 OR
               asr_vad_silence_ms LESS 100 OR asr_vad_silence_ms GREATER 2000 OR
               asr_vad_padding_ms GREATER 1000)
                message(FATAL_ERROR "ASR VAD settings exceed the supported bounds")
            endif()
            set(asr_pair "${asr_family}/${asr_profile}")
            if(asr_pair IN_LIST asr_pairs)
                message(FATAL_ERROR "Duplicate ASR model/profile")
            endif()
            list(APPEND asr_pairs "${asr_pair}")
            foreach(field japanese_only gpu_validated vad_gain)
                if(asr_${field})
                    set(asr_${field} true)
                else()
                    set(asr_${field} false)
                endif()
            endforeach()
            string(APPEND ASR_ENTRIES "    {static_cast<ModelId>(${index}), AsrModel::${cpp_family_${asr_family}}, AsrProfile::${cpp_profile_${asr_profile}}, ${asr_family_resource}, ${asr_choice_resource}, ${asr_result_resource}, ${asr_japanese_only}, ${asr_gpu_bytes}ULL, ${asr_gpu_validated}, ${asr_history_tokens}, ${asr_vad_threshold_milli}, ${asr_vad_silence_ms}, ${asr_vad_padding_ms}, AsrEngine::${cpp_engine_${asr_engine}}, ${asr_tokens_value}, ${asr_frame_ms}, ${asr_vad_gain}, ${asr_external_value}},\n")
            math(EXPR ASR_COUNT "${ASR_COUNT} + 1")
        endif()
    endforeach()
    if(NOT ASR_COUNT EQUAL 6)
        message(FATAL_ERROR "Expected the six validated ASR configurations")
    endif()

    # 同じ音声モデルの文脈優先/従来区切りだけを唯一registryへ追加する。
    string(JSON api_count LENGTH "${model_manifest}" api_asr)
    if(NOT api_count EQUAL 2)
        message(FATAL_ERROR "Expected two explicit audio API split configurations")
    endif()
    foreach(api_index RANGE 0 1)
        foreach(field family profile engine model_id endpoint family_resource choice_resource result_resource vad_threshold_milli vad_silence_ms vad_padding_ms vad_gain)
            string(JSON api_${field} GET "${model_manifest}" api_asr ${api_index} ${field})
        endforeach()
        if(api_index EQUAL 0)
            set(expected_profile Quality)
            set(expected_choice 3401)
        else()
            set(expected_profile Standard)
            set(expected_choice 3443)
        endif()
        if(NOT api_family STREQUAL "OpenAiAudio" OR NOT api_profile STREQUAL expected_profile OR
           NOT api_engine STREQUAL "OpenAiTranscriptions" OR NOT api_model_id STREQUAL "gpt-transcribe" OR
           NOT api_endpoint STREQUAL "https://api.openai.com/v1/audio/transcriptions" OR
           NOT api_family_resource EQUAL 3400 OR NOT api_choice_resource EQUAL expected_choice OR
           NOT api_result_resource EQUAL 3400 OR NOT api_vad_threshold_milli EQUAL 350 OR
           NOT api_vad_silence_ms EQUAL 800 OR NOT api_vad_padding_ms EQUAL 500 OR NOT api_vad_gain)
            message(FATAL_ERROR "Invalid fixed audio API contract")
        endif()
        string(APPEND ASR_ENTRIES "    {std::nullopt, AsrModel::${cpp_family_${api_family}}, AsrProfile::${cpp_profile_${api_profile}}, ${api_family_resource}, ${api_choice_resource}, ${api_result_resource}, false, 0, false, 0, 350, 800, 500, AsrEngine::${cpp_engine_${api_engine}}, std::nullopt, 0, true, std::nullopt, \"${api_model_id}\"},\n")
        math(EXPR ASR_COUNT "${ASR_COUNT} + 1")
    endforeach()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/model_downloads.cmake")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/model_manifest.h.in" "${output_path}" @ONLY)
endfunction()
