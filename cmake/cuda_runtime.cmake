set(KOEFUDE_SHERPA_DIR "${KOEFUDE_SHERPA_CPU_DIR}")
set(KOEFUDE_RUNTIME_FILES "")
if(KOEFUDE_CUDA)
    set(KOEFUDE_SHERPA_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/sherpa-onnx-cuda")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.lock.json")
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.lock.json" dependency_manifest)
    string(JSON dependency_count LENGTH "${dependency_manifest}" dependencies)
    math(EXPR dependency_last "${dependency_count} - 1")
    set(runtime_names "")
    foreach(dependency_index RANGE 0 ${dependency_last})
        string(JSON runtime_type ERROR_VARIABLE runtime_error TYPE "${dependency_manifest}" dependencies ${dependency_index} runtime_files)
        if(runtime_error)
            continue()
        endif()
        string(JSON dependency_dir GET "${dependency_manifest}" dependencies ${dependency_index} directory)
        string(JSON runtime_count LENGTH "${dependency_manifest}" dependencies ${dependency_index} runtime_files)
        math(EXPR runtime_last "${runtime_count} - 1")
        foreach(runtime_index RANGE 0 ${runtime_last})
            foreach(field file size sha256)
                string(JSON runtime_${field} GET "${dependency_manifest}" dependencies ${dependency_index} runtime_files ${runtime_index} ${field})
            endforeach()
            if(dependency_dir MATCHES "(^[/\\\\]|[.][.]|:)" OR runtime_file MATCHES "(^[/\\\\]|[.][.]|:)")
                message(FATAL_ERROR "Invalid runtime manifest path")
            endif()
            set(runtime_path "${CMAKE_CURRENT_SOURCE_DIR}/third_party/${dependency_dir}/${runtime_file}")
            if(NOT EXISTS "${runtime_path}")
                message(FATAL_ERROR "CUDA dependency missing: run scripts/setup.py --dependencies")
            endif()
            file(SIZE "${runtime_path}" actual_size)
            file(SHA256 "${runtime_path}" actual_sha256)
            if(NOT actual_size EQUAL runtime_size OR NOT actual_sha256 STREQUAL runtime_sha256)
                message(FATAL_ERROR "CUDA dependency verification failed: ${runtime_file}")
            endif()
            get_filename_component(runtime_name "${runtime_file}" NAME)
            if(runtime_name IN_LIST runtime_names)
                message(FATAL_ERROR "Duplicate runtime DLL name")
            endif()
            list(APPEND runtime_names "${runtime_name}")
            list(APPEND KOEFUDE_RUNTIME_FILES "${runtime_path}")
        endforeach()
    endforeach()
    list(LENGTH KOEFUDE_RUNTIME_FILES runtime_count)
    if(NOT runtime_count EQUAL 18)
        message(FATAL_ERROR "The validated CUDA runtime requires exactly eighteen DLLs")
    endif()
else()
    foreach(runtime sherpa-onnx-c-api.dll onnxruntime.dll onnxruntime_providers_shared.dll)
        list(APPEND KOEFUDE_RUNTIME_FILES "${KOEFUDE_SHERPA_DIR}/lib/${runtime}")
    endforeach()
endif()
