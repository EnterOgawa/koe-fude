#pragma once
#include <cstdint>
namespace koefude::whisper_cpu::manifest {
// falseは明示portable専用構成です
inline constexpr bool K_SLOT_PRESENT = @WC_SLOT@;
// 固定basename以外を探索しません
inline constexpr wchar_t K_DLL_NAME[] = L"KoeFude.WhisperCpu.Avx2.dll";
// 同じfolderに置く完成receiptです
inline constexpr wchar_t K_RECEIPT_NAME[] = L"KoeFude.WhisperCpu.Avx2.runtime.json";
// 検証済みDLLの全byte数です
inline constexpr std::uint64_t K_DLL_BYTES = @WC_DLL_BYTES@ULL;
// 検証済みDLLの全byte digestです
inline constexpr char K_DLL_SHA256[] = "@WC_DLL_SHA256@";
// receipt全byteのdigestです
inline constexpr char K_RECEIPT_SHA256[] = "@WC_RECEIPT_SHA256@";
// 共有する私有ABI headerのdigestです
inline constexpr char K_ABI_HEADER_SHA256[] = "@WC_ABI_SHA256@";
// native DLLと同じ構成を要求します
inline constexpr char K_CONFIGURATION[] = "@WC_CONFIGURATION@";
} // namespace koefude::whisper_cpu::manifest
