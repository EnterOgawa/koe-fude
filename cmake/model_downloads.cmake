# models.lock.jsonから準備metadataを生成します。通信やfile書込みは行いません。
# 1.0.0 Shunji Ogawa 2026/11/11 ADR1410の生成C++識別子だけを明示mappingへ分離。
# 0.1.0 Shunji Ogawa 2026/09/13 選択構成の取得条件・共有用途を固定。
# 0.1.0 Shunji Ogawa 2026/10/19 固定local用途だけのsigned64最終sizeを許可。
# 0.1.0 Shunji Ogawa 2026/10/20 lockを正本に専用Directのscopeと容量境界を検査。

function(koefude_model_hash value)
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Model SHA-256 must be 64 lowercase hex digits")
    endif()
endfunction()

function(koefude_model_size value)
    if(NOT value MATCHES "^[1-9][0-9]*$" OR value GREATER 8589934592)
        message(FATAL_ERROR "Model artifact size must be within 1..8 GiB")
    endif()
endfunction()

function(koefude_model_path value)
    if(NOT value MATCHES "^[A-Za-z0-9_][A-Za-z0-9_./-]*$" OR
       value MATCHES "(^|/)\\.\\.?(/|$)|//|/$|[.]/|[.]$")
        message(FATAL_ERROR "Model file must be a safe relative regular-file path")
    endif()
    string(TOUPPER "${value}" upper)
    if(upper MATCHES "(^|/)(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])([.]|/|$)")
        message(FATAL_ERROR "Model file cannot use a Windows device name")
    endif()
endfunction()

# registryの取得方式名を変更せず、生成するC++ enumだけを対応させる。
set(cpp_transfer_Direct DIRECT)
set(cpp_transfer_TarBzip2 TAR_BZIP2)
set(cpp_transfer_MetadataAppend METADATA_APPEND)
set(cpp_transfer_Unavailable UNAVAILABLE)
set(DOWNLOAD_ENTRIES "")
set(download_urls "")
math(EXPR model_last "${model_count} - 1")
foreach(index RANGE 0 ${model_last})
    foreach(field id file size sha256 revision license source)
        string(JSON download_${field} GET "${model_manifest}" models ${index} ${field})
    endforeach()
    if(NOT download_id MATCHES "^[a-z0-9.-]+$" OR
       NOT download_revision MATCHES "^[a-z0-9-]+$" OR
       NOT download_license MATCHES "^[A-Za-z0-9 .;()-]+$" OR
       NOT download_source MATCHES "^https://[A-Za-z0-9_./-]+$")
        message(FATAL_ERROR "Invalid model identity, revision or attribution metadata")
    endif()
    koefude_model_path("${download_file}")
    koefude_model_hash("${download_sha256}")
    string(JSON old_type ERROR_VARIABLE old_error TYPE "${model_manifest}" models ${index} local_verification_only)
    string(JSON scope_type ERROR_VARIABLE scope_error TYPE "${model_manifest}" models ${index} acquisition_scope)
    # 通常の8GiB境界は変えず、固定用途13の完全一致だけを例外にします。
    if(NOT old_error)
        message(FATAL_ERROR "Obsolete local verification flag is not supported")
    endif()
    if(index EQUAL 13)
        string(JSON scope_value GET "${model_manifest}" models ${index} acquisition_scope)
        string(JSON whole_role GET "${model_manifest}" whole_text_roles native_cpu)
        string(JSON repository GET "${model_manifest}" models ${index} repository)
        string(JSON whole_url GET "${model_manifest}" models ${index} url)
        if(NOT scope_type STREQUAL "STRING" OR NOT scope_value STREQUAL "whole_text" OR
           NOT whole_role STREQUAL "13" OR
           NOT download_id STREQUAL "gemma-4-31b-it-qat-q4-0-gguf" OR
           NOT download_file STREQUAL "gemma-4-31B_q4_0-it.gguf" OR
           NOT repository STREQUAL "google/gemma-4-31B-it-qat-q4_0-gguf" OR
           NOT download_size STREQUAL "17651001568" OR
           NOT whole_url STREQUAL "https://huggingface.co/${repository}/resolve/${download_revision}/${download_file}")
            message(FATAL_ERROR "Invalid fixed whole-text Direct artifact")
        endif()
        foreach(forbidden asr comparison_only archive_size archive_sha256 metadata_append_hex source_size source_sha256)
            string(JSON forbidden_type ERROR_VARIABLE forbidden_error TYPE "${model_manifest}" models ${index} ${forbidden})
            if(NOT forbidden_error)
                message(FATAL_ERROR "Whole-text Direct cannot mix ASR/comparison/archive/append routing")
            endif()
        endforeach()
    else()
        if(index EQUAL 14)
            string(JSON scope_value GET "${model_manifest}" models ${index} acquisition_scope)
            string(JSON whole_role_16gb GET "${model_manifest}" whole_text_roles native_cpu_16gb)
            string(JSON repository GET "${model_manifest}" models ${index} repository)
            if(NOT scope_type STREQUAL "STRING" OR NOT scope_value STREQUAL "whole_text" OR
               NOT whole_role_16gb STREQUAL "14" OR
               NOT download_id STREQUAL "ministral-3-14b-instruct-2512-q4-k-m-gguf" OR
               NOT download_file STREQUAL "Ministral-3-14B-Instruct-2512-Q4_K_M.gguf" OR
               NOT repository STREQUAL "mistralai/Ministral-3-14B-Instruct-2512-GGUF" OR
               NOT download_revision STREQUAL "74fac473c43357d7fb2671713608183cc72496d0" OR
               NOT download_size STREQUAL "8239593024" OR
               NOT download_sha256 STREQUAL "824e0f3373e69b84f2cae46fdcb9bd1ebc6ab3bfc7acc125d818b7b8178cc613" OR
               NOT download_license STREQUAL "Apache-2.0" OR
               NOT download_source STREQUAL "https://huggingface.co/${repository}/tree/${download_revision}")
                message(FATAL_ERROR "Invalid fixed Ministral16GB Direct artifact")
            endif()
            string(JSON fixed_url GET "${model_manifest}" models ${index} url)
            if(NOT fixed_url STREQUAL "https://huggingface.co/${repository}/resolve/${download_revision}/${download_file}")
                message(FATAL_ERROR "Ministral requires its exact immutable Direct URL")
            endif()
            foreach(forbidden asr comparison_only archive_size archive_sha256 metadata_append_hex source_size source_sha256)
                string(JSON forbidden_type ERROR_VARIABLE forbidden_error TYPE "${model_manifest}" models ${index} ${forbidden})
                if(NOT forbidden_error)
                    message(FATAL_ERROR "Ministral Direct cannot mix alternate routing")
                endif()
            endforeach()
        elseif(NOT scope_error)
            message(FATAL_ERROR "Acquisition scope is reserved for whole-text roles")
        endif()
        koefude_model_size("${download_size}")
    endif()
    set(download_url "")
    set(transfer_size 0)
    set(transfer_hash "")
    set(member "")
    set(suffix "")
    set(kind Unavailable)
    string(JSON comparison ERROR_VARIABLE comparison_error GET "${model_manifest}" models ${index} comparison_only)
    if(comparison_error OR NOT comparison)
        string(JSON download_url GET "${model_manifest}" models ${index} url)
        if(NOT download_url MATCHES "^https://(huggingface[.]co|github[.]com)/[A-Za-z0-9_./-]+$")
            message(FATAL_ERROR "Product model URL is outside the fixed HTTPS source allowlist")
        endif()
        if(download_url MATCHES "^https://huggingface[.]co/")
            string(LENGTH "${download_revision}" revision_length)
            string(FIND "${download_url}" "/resolve/${download_revision}/" revision_position)
            if(NOT revision_length EQUAL 40 OR NOT download_revision MATCHES "^[0-9a-f]+$" OR
               revision_position LESS 0)
                message(FATAL_ERROR "Hugging Face model must use its immutable revision")
            endif()
        endif()
        set(kind Direct)
        set(transfer_size "${download_size}")
        set(transfer_hash "${download_sha256}")
        string(JSON archive_size ERROR_VARIABLE archive_error GET "${model_manifest}" models ${index} archive_size)
        string(JSON suffix_value ERROR_VARIABLE suffix_error GET "${model_manifest}" models ${index} metadata_append_hex)
        if(NOT archive_error AND NOT suffix_error)
            message(FATAL_ERROR "Archive and metadata-append preparation cannot be combined")
        endif()
        if(NOT archive_error)
            if(NOT download_url MATCHES "[.]tar[.]bz2$")
                message(FATAL_ERROR "Unsupported model archive format")
            endif()
            set(kind TarBzip2)
            set(member "${download_file}")
            set(transfer_size "${archive_size}")
            string(JSON transfer_hash GET "${model_manifest}" models ${index} archive_sha256)
        elseif(NOT suffix_error)
            set(kind MetadataAppend)
            set(suffix "${suffix_value}")
            string(LENGTH "${suffix}" suffix_length)
            math(EXPR suffix_remainder "${suffix_length} % 2")
            string(JSON transfer_size GET "${model_manifest}" models ${index} source_size)
            string(JSON transfer_hash GET "${model_manifest}" models ${index} source_sha256)
            math(EXPR final_size "${transfer_size} + ${suffix_length} / 2")
            if(NOT suffix MATCHES "^[0-9a-f]+$" OR suffix_length GREATER 16384 OR
               NOT suffix_remainder EQUAL 0 OR transfer_size GREATER 2097152 OR
               NOT final_size EQUAL download_size)
                message(FATAL_ERROR "Invalid bounded metadata-append preparation")
            endif()
        elseif(download_url MATCHES "[.]tar[.]bz2$")
            message(FATAL_ERROR "Archive URL requires artifact size and hash")
        endif()
        if(NOT index EQUAL 13)
            koefude_model_size("${transfer_size}")
        endif()
        koefude_model_hash("${transfer_hash}")
        # 同じURLの別memberに矛盾する転送条件を与えない。
        string(SHA256 url_key "${download_url}")
        set(identity "${transfer_size}:${transfer_hash}")
        if(DEFINED transfer_${url_key} AND NOT transfer_${url_key} STREQUAL identity)
            message(FATAL_ERROR "Shared model archive has inconsistent size/hash")
        endif()
        set(transfer_${url_key} "${identity}")
    endif()
    string(APPEND DOWNLOAD_ENTRIES "    {ModelTransferKind::${cpp_transfer_${kind}}, \"${download_url}\", \"${download_revision}\", \"${download_license}\", \"${download_source}\", ${transfer_size}ULL, \"${transfer_hash}\", \"${member}\", \"${suffix}\"},\n")
endforeach()

foreach(role voice_activity segmentation embedding)
    string(JSON role_index GET "${model_manifest}" shared_roles ${role})
    if(NOT role_index MATCHES "^[0-9]+$" OR role_index GREATER_EQUAL model_count)
        message(FATAL_ERROR "Invalid shared model role")
    endif()
    string(JSON comparison ERROR_VARIABLE comparison_error GET "${model_manifest}" models ${role_index} comparison_only)
    string(JSON asr_type ERROR_VARIABLE asr_error TYPE "${model_manifest}" models ${role_index} asr)
    if((NOT comparison_error AND comparison) OR NOT asr_error)
        message(FATAL_ERROR "Shared role cannot reference an ASR or comparison-only asset")
    endif()
    string(TOUPPER "${role}" upper_role)
    set(ROLE_${upper_role} "${role_index}")
endforeach()
# 現行native adapterの用途契約と一致することを確認する。
if(NOT ROLE_VOICE_ACTIVITY EQUAL 4 OR NOT ROLE_SEGMENTATION EQUAL 1 OR NOT ROLE_EMBEDDING EQUAL 2)
    message(FATAL_ERROR "Shared model roles do not match the validated native adapters")
endif()
