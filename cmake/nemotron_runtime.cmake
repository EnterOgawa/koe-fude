# ADR 1451: 固定した公式CPUアーカイブから、話者分離に使うDLLとライセンスだけを配置
set(KOEFUDE_NEMOTRON_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/nemo-speech-cpu")
set(nemotron_lock "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.lock.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${nemotron_lock}")
file(READ "${nemotron_lock}" nemotron_dependencies)
string(JSON nemotron_id GET "${nemotron_dependencies}" dependencies 0 id)
if(NOT nemotron_id STREQUAL "nemo-speech-cpu")
    message(FATAL_ERROR "NeMo Speech CPU dependency is missing from dependencies.lock.json")
endif()
if(NOT EXISTS "${KOEFUDE_NEMOTRON_ROOT}/include/nemo_speech/diar.h")
    message(FATAL_ERROR "Run scripts/setup.py --dependencies or scripts/prepare_ci_dependencies.py for fixed dependencies")
endif()
string(JSON nemotron_last LENGTH "${nemotron_dependencies}" dependencies 0 diarization_runtime_files)
math(EXPR nemotron_last "${nemotron_last} - 1")
set(nemotron_runtime "")
foreach(index RANGE 0 ${nemotron_last})
    foreach(key file size sha256)
        string(JSON nemotron_${key} GET "${nemotron_dependencies}" dependencies 0 diarization_runtime_files ${index} ${key})
    endforeach()
    if(NOT nemotron_file MATCHES "^bin/[a-z0-9_-]+[.]dll$")
        message(FATAL_ERROR "Invalid NeMo Speech CPU runtime filename")
    endif()
    set(source "${KOEFUDE_NEMOTRON_ROOT}/${nemotron_file}")
    file(SIZE "${source}" runtime_size)
    file(SHA256 "${source}" runtime_sha256)
    if(NOT runtime_size EQUAL nemotron_size OR NOT runtime_sha256 STREQUAL nemotron_sha256)
        message(FATAL_ERROR "The fixed NeMo Speech CPU runtime differs: ${nemotron_file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    list(APPEND nemotron_runtime "${source}")
endforeach()
set(nemotron_output_dirs "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
if(CMAKE_CONFIGURATION_TYPES)
    set(nemotron_output_dirs "")
    foreach(configuration IN LISTS CMAKE_CONFIGURATION_TYPES)
        list(APPEND nemotron_output_dirs "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/${configuration}")
    endforeach()
endif()
foreach(destination IN LISTS nemotron_output_dirs)
    file(COPY ${nemotron_runtime} DESTINATION "${destination}/nemotron-3")
    file(COPY "${KOEFUDE_NEMOTRON_ROOT}/share/licenses/nemo-speech"
        DESTINATION "${destination}/nemotron-3/licenses")
endforeach()
