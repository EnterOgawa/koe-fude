function(koefude_whisper_cpu_regular path basename)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR
       IS_SYMLINK "${path}" OR "${path}" MATCHES "^[/\\\\]{2}")
        message(FATAL_ERROR "Whisper CPU requires an absolute regular local file")
    endif()
    get_filename_component(name "${path}" NAME)
    if(NOT name STREQUAL basename)
        message(FATAL_ERROR "Whisper CPU basename mismatch")
    endif()
    get_filename_component(ancestor "${path}" DIRECTORY)
    while(NOT ancestor STREQUAL "")
        if(IS_SYMLINK "${ancestor}")
            message(FATAL_ERROR "Whisper CPU rejects reparse ancestors")
        endif()
        get_filename_component(next "${ancestor}" DIRECTORY)
        if(next STREQUAL ancestor)
            break()
        endif()
        set(ancestor "${next}")
    endwhile()
endfunction()

# 自作ABIとpatch scriptも現在のsourceへ固定します。
function(koefude_whisper_cpu_source_pins)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(paths third_party/whisper.cpp/src/whisper.cpp third_party/whisper.cpp/include/whisper.h
        third_party/whisper.cpp/ggml/include/ggml.h third_party/whisper.cpp/ggml/include/ggml-cpu.h
        third_party/whisper.cpp/LICENSE)
    set(pins "${_wc_source}" "${_wc_whisper}" "${_wc_ggml}" "${_wc_cpu_header}" "${_wc_license}")
    foreach(index RANGE 0 4)
        list(GET paths ${index} path)
        list(GET pins ${index} expected)
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Whisper CPU source/header/license pin mismatch: ${path}")
        endif()
    endforeach()
    file(SHA256 "${root}/src/inference/whisper_cpu_abi.h" abi)
    file(SHA256 "${root}/cmake/whisper_cpu_exception_safety.cmake" patch)
    set(WC_ABI_SHA256 "${abi}" PARENT_SCOPE)
    set(WC_PATCH_SHA256 "${patch}" PARENT_SCOPE)
endfunction()

function(koefude_whisper_cpu_validate runtime configuration)
    koefude_whisper_cpu_regular("${runtime}" "${_wc_dll}")
    if(NOT configuration STREQUAL "Debug" AND NOT configuration STREQUAL "Release")
        message(FATAL_ERROR "Whisper CPU requires Debug or Release")
    endif()
    koefude_whisper_cpu_source_pins()
    get_filename_component(parent "${runtime}" DIRECTORY)
    set(receipt "${parent}/${_wc_receipt}")
    koefude_whisper_cpu_regular("${receipt}" "${_wc_receipt}")
    file(READ "${receipt}" json LIMIT 8193)
    string(LENGTH "${json}" length)
    if(length GREATER 8192)
        message(FATAL_ERROR "Whisper CPU receipt exceeds 8192 bytes")
    endif()
    file(SHA256 "${runtime}" dll_sha)
    file(SIZE "${runtime}" dll_bytes)
    set(fields schema configuration architecture toolset static_crt abi_version
        engine_commit whisper_header_sha256 ggml_header_sha256 ggml_cpu_header_sha256
        abi_header_sha256 original_source_sha256 patch_script_sha256 license_sha256
        cpu_contract required_features_mask xcr0_mask cpu_repack dll_name dll_bytes dll_sha256
        generated_source_sha256 generated_diff_sha256)
    set(expected 1 "${configuration}" x64 14.44.35207 ON 1 "${_wc_commit}" "${_wc_whisper}"
        "${_wc_ggml}" "${_wc_cpu_header}" "${WC_ABI_SHA256}" "${_wc_source}"
        "${WC_PATCH_SHA256}" "${_wc_license}" "${_wc_contract}" 32767 6 ON "${_wc_dll}"
        "${dll_bytes}" "${dll_sha}" "${_wc_generated}" "${_wc_diff}")
    list(LENGTH fields count)
    string(JSON members ERROR_VARIABLE error LENGTH "${json}")
    string(REGEX MATCHALL "\"[a-z0-9_]+\"[ \t\r\n]*:" keys "${json}")
    list(LENGTH keys key_count)
    if(error OR NOT members EQUAL count OR NOT key_count EQUAL count)
        message(FATAL_ERROR "Whisper CPU receipt field/duplicate key mismatch")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        list(GET fields ${index} field)
        string(JSON value ERROR_VARIABLE error GET "${json}" "${field}")
        string(JSON kind ERROR_VARIABLE kind_error TYPE "${json}" "${field}")
        if(error OR kind_error)
            message(FATAL_ERROR "Whisper CPU receipt invalid field: ${field}")
        endif()
        if(field MATCHES "^(schema|abi_version|required_features_mask|xcr0_mask|dll_bytes)$")
            set(expected_kind NUMBER)
        elseif(field MATCHES "^(static_crt|cpu_repack)$")
            set(expected_kind BOOLEAN)
        else()
            set(expected_kind STRING)
        endif()
        if(NOT kind STREQUAL expected_kind)
            message(FATAL_ERROR "Whisper CPU receipt type mismatch: ${field}")
        endif()
        list(GET expected ${index} wanted)
        if(NOT value STREQUAL wanted)
            message(FATAL_ERROR "Whisper CPU receipt pin mismatch: ${field}")
        endif()
    endforeach()
    file(SHA256 "${receipt}" receipt_sha)
    set(WC_VALIDATED_DLL_BYTES "${dll_bytes}" PARENT_SCOPE)
    set(WC_VALIDATED_DLL_SHA256 "${dll_sha}" PARENT_SCOPE)
    set(WC_VALIDATED_RECEIPT_SHA256 "${receipt_sha}" PARENT_SCOPE)
    set(WC_VALIDATED_ABI_SHA256 "${WC_ABI_SHA256}" PARENT_SCOPE)
endfunction()

# 空pathは明示portable専用buildです。予定資産の欠落とは区別します。
function(koefude_whisper_cpu_manifest runtime configuration output)
    if(NOT configuration STREQUAL "Debug" AND NOT configuration STREQUAL "Release")
        message(FATAL_ERROR "Whisper CPU manifest configuration mismatch")
    endif()
    set(WC_SLOT false)
    set(WC_DLL_BYTES 0)
    set(WC_DLL_SHA256 "")
    set(WC_RECEIPT_SHA256 "")
    set(WC_ABI_SHA256 "")
    if(NOT runtime STREQUAL "")
        koefude_whisper_cpu_validate("${runtime}" "${configuration}")
        set(WC_SLOT true)
        set(WC_DLL_BYTES "${WC_VALIDATED_DLL_BYTES}")
        set(WC_DLL_SHA256 "${WC_VALIDATED_DLL_SHA256}")
        set(WC_RECEIPT_SHA256 "${WC_VALIDATED_RECEIPT_SHA256}")
        set(WC_ABI_SHA256 "${WC_VALIDATED_ABI_SHA256}")
    endif()
    set(WC_CONFIGURATION "${configuration}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/whisper_cpu_runtime_manifest.h.in"
        "${output}" @ONLY)
endfunction()

if(DEFINED WC_MODE)
    if(WC_MODE STREQUAL "GENERATE")
        koefude_whisper_cpu_regular("${WC_RUNTIME}" "${_wc_dll}")
        koefude_whisper_cpu_source_pins()
        if(NOT WC_CONFIG STREQUAL "Debug" AND NOT WC_CONFIG STREQUAL "Release")
            message(FATAL_ERROR "Whisper CPU producer configuration mismatch")
        endif()
        file(SHA256 "${WC_GENERATED_SOURCE}" generated_sha)
        file(SHA256 "${WC_GENERATED_SOURCE}.diff" diff_sha)
        file(SHA256 "${WC_RUNTIME}" dll_sha)
        file(SIZE "${WC_RUNTIME}" dll_bytes)
        get_filename_component(parent "${WC_RUNTIME}" DIRECTORY)
        file(WRITE "${parent}/${_wc_receipt}" "{\n  \"schema\": 1,\n  \"configuration\": \"${WC_CONFIG}\",\n  \"architecture\": \"x64\",\n  \"toolset\": \"14.44.35207\",\n  \"static_crt\": true,\n  \"abi_version\": 1,\n  \"engine_commit\": \"${_wc_commit}\",\n  \"whisper_header_sha256\": \"${_wc_whisper}\",\n  \"ggml_header_sha256\": \"${_wc_ggml}\",\n  \"ggml_cpu_header_sha256\": \"${_wc_cpu_header}\",\n  \"abi_header_sha256\": \"${WC_ABI_SHA256}\",\n  \"original_source_sha256\": \"${_wc_source}\",\n  \"patch_script_sha256\": \"${WC_PATCH_SHA256}\",\n  \"license_sha256\": \"${_wc_license}\",\n  \"cpu_contract\": \"${_wc_contract}\",\n  \"required_features_mask\": 32767,\n  \"xcr0_mask\": 6,\n  \"cpu_repack\": true,\n  \"dll_name\": \"${_wc_dll}\",\n  \"dll_bytes\": ${dll_bytes},\n  \"dll_sha256\": \"${dll_sha}\",\n  \"generated_source_sha256\": \"${generated_sha}\",\n  \"generated_diff_sha256\": \"${diff_sha}\"\n}\n")
        koefude_whisper_cpu_validate("${WC_RUNTIME}" "${WC_CONFIG}")
    elseif(WC_MODE STREQUAL "VALIDATE")
        koefude_whisper_cpu_validate("${WC_RUNTIME}" "${WC_CONFIG}")
    elseif(WC_MODE STREQUAL "MANIFEST")
        koefude_whisper_cpu_manifest("${WC_RUNTIME}" "${WC_CONFIG}" "${WC_OUTPUT}")
    else()
        message(FATAL_ERROR "Unknown Whisper CPU receipt mode")
    endif()
endif()
