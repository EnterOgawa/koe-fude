//------------------------------------------------------------------------------
/**
 * @file ui_ja.rcinc
 * @brief 言語別のUI文字列と標準menuを定義します。
 * @version 1.0.0
 * @date 2026/09/09
 * @author Shunji Ogawa
 * @copyright Copyright (c) 2026 Shunji Ogawa. MIT License.
 * @par 更新履歴
 * <pre>
 * 1.0.0 Shunji Ogawa 2026/11/10 ADR1385のWhisper表示を中立化。
 * 1.0.0 Shunji Ogawa 2026/11/10 ADR1382の案内fontをMS ゴシックへ統一。
 * 1.0.0 Shunji Ogawa 2026/11/10 ADR1380の短い状態と一回の詳細通知を追加。
 * 1.0.0 Shunji Ogawa 2026/11/10 ADR1378の明示更新境界を追加。
 * 0.1.0 Shunji Ogawa 2026/11/10 ADR1375の適用済み選好の保存と復元を追加。
 * 0.1.0 Shunji Ogawa 2026/11/10 ADR1370の文脈分割と明示途中再開を接続。
 * 0.1.0 Shunji Ogawa 2026/11/09 ADR1367のGPU優先/CPU自動表示を明確化。
 * 0.1.0 Shunji Ogawa 2026/11/09 ADR1360の話者区切り検証案内を追加。
 * 0.1.0 Shunji Ogawa 2026/11/09 ADR1354の縦一覧と統合設定menuへ変更。
 * 0.1.0 Shunji Ogawa 2026/10/04 保存済み整形の表示選択と版/件数/字幕案内を追加。
 * 0.1.0 Shunji Ogawa 2026/10/02 WAVの画面接続・入力説明と検証を追加。
 * 0.1.0 Shunji Ogawa 2026/10/02 MP3の対応範囲と入力案内を追加。
 * 0.1.0 Shunji Ogawa 2026/10/02 native FLACの対応範囲と入力案内を追加。
 * 0.1.0 Shunji Ogawa 2026/10/02 M4A内ALACの対応属性と範囲外案内を追加。
 * 0.1.0 Shunji Ogawa 2026/10/02 HE-AACの対応属性と編集情報等の非対応範囲を案内。
 * 0.1.0 Shunji Ogawa 2026/09/11 複数候補の理由と時間範囲を日本語で表示。
 * 0.1.0 Shunji Ogawa 2026/09/09 初期デスクトップresourceを追加。
 * 0.1.0 Shunji Ogawa 2026/09/09 品質優先modelと無音除外の選択を表示。
 * 0.1.0 Shunji Ogawa 2026/09/09 常設品質欄と同梱modelの案内へ変更。
 * 0.1.0 Shunji Ogawa 2026/09/09 モデル系統とモデル別品質の選択を表示。
 * 0.1.0 Shunji Ogawa 2026/09/09 表示言語と話者フィルターを追加。
 * 0.1.0 Shunji Ogawa 2026/09/09 履歴の右クリックから再実行する操作を追加。
 * 0.1.0 Shunji Ogawa 2026/09/09 音声長と実測処理時間の表示を追加。
 * 0.1.0 Shunji Ogawa 2026/09/10 永続履歴の管理と保存状態の表示を追加。
 * 0.1.0 Shunji Ogawa 2026/09/10 長時間処理と一時領域の失敗案内を追加。
 * 0.1.0 Shunji Ogawa 2026/09/10 採用した日本語CTCの推奨表示と一つのCPU構成を追加。
 * 0.1.0 Shunji Ogawa 2026/09/11 CTCの品質優先FP32、軽量INT8、CUDAとCPU再試行を表示。
 * 0.1.0 Shunji Ogawa 2026/09/13 不足モデルの明示取得と準備状態を日本語で表示。
 * 0.1.0 Shunji Ogawa 2026/09/27 設定欄のアクセシビリティ目的名を追加。
 * 0.1.0 Shunji Ogawa 2026/11/09 ADR1368の明示音声APIと従来経路の境界を接続。
 * </pre>
 */
//------------------------------------------------------------------------------
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_MESSAGE_OK "OK"
    IDS_MESSAGE_YES "はい(&Y)"
    IDS_MESSAGE_NO "いいえ(&N)"
    IDS_MESSAGE_CANCEL "キャンセル"
    IDS_PREP_TITLE "モデルを準備"
    IDS_PREP_INTRO "選択した構成の不足分だけを取得します。準備後はオフラインで文字起こしできます。\r\n取得中も結果の閲覧・コピー・保存ができます。この画面を閉じても取得は続きます。"
    IDS_PREP_STORAGE "使用する保存先:"
    IDS_PREP_CAPACITY "モデル容量（GPUメモリ使用量とは異なります）:"
    IDS_PREP_TRANSFER "追加ダウンロード:"
    IDS_PREP_DISK "準備に必要な追加空き容量（一時領域を含む）:"
    IDS_PREP_HOSTS "通信先（HTTPS。配布先からの転送先を含む）:"
    IDS_PREP_TERMS "配布条件: 各モデルの条件と配布元を以下に示します。詳細は同梱のTHIRD_PARTY_NOTICES.mdとlicensesを参照してください。音声・文字起こし・ファイル名は送信しません。"
    IDS_PREP_SOURCE "配布元・条件:"
    IDS_PREP_ROLE_VAD "発話区間の検出"
    IDS_PREP_ROLE_ASR "文字起こし・補助データ"
    IDS_PREP_DOWNLOAD "ダウンロードして使用(&D)"
    IDS_PREP_RECHECK "再確認（通信なし）(&R)"
    270 "モデルを確認中です。キャンセルできます。"
    271 "準備が必要です。条件と容量を確認して取得してください。準備後に音声を追加できます。"
    272 "既存モデルを保存先へコピーしています。"
    273 "モデルをダウンロードしています。"
    274 "容量とSHA-256を検証しています。"
    275 "検証済みデータからモデルを準備しています。"
    276 "準備ができました。画面を閉じて音声を追加してください。"
    277 "キャンセル中です。実行中の処理と一時ファイルの回収を待っています。"
    278 "キャンセルしました。検証済みのモデルは次回再利用します。再確認して続けられます。"
    279 "準備できませんでした。空き容量・保存先の権限・通信接続を確認して再試行してください。診断:"
END

IDR_MAIN_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "音声を追加(&O)…\tCtrl+O", IDC_OPEN
        MENUITEM "文字起こしを保存(&S)…\tCtrl+S", IDC_SAVE
        MENUITEM "再実行(&R)", IDC_RETRANSCRIBE
        MENUITEM "APIで文章を改善(&A)", IDC_API_TEXT_OPEN
        MENUITEM "取消し(&C)", IDC_CANCEL
        MENUITEM SEPARATOR
        MENUITEM "履歴の保存・読込を再試行(&H)", IDC_HISTORY_RETRY
        MENUITEM "終了(&X)", IDC_EXIT
    END
    POPUP "編集(&E)"
    BEGIN
        MENUITEM "全文コピー(&C)", IDC_COPY
        MENUITEM "話者名を変更(&N)…", IDC_RENAME
        MENUITEM "選択した履歴を削除(&D)\tDelete", IDC_HISTORY_REMOVE
        MENUITEM "履歴を全削除(&L)", IDC_CLEAR
    END
    POPUP "設定(&S)"
    BEGIN
        MENUITEM "設定(&S)…", IDC_SETTINGS_OPEN
        MENUITEM SEPARATOR
        MENUITEM "更新を確認(&U)…", IDC_UPDATE_CHECK
        MENUITEM "更新を取得…", IDC_UPDATE_INSTALL
        MENUITEM "更新処理を取消し", IDC_UPDATE_CANCEL
    END
END

STRINGTABLE
BEGIN
    IDS_UPDATE_STARTUP "起動時に更新を確認する（GitHub）"
    IDS_UPDATE_PRIVACY "起動時は公開版の情報だけを確認します。取得・インストールは自分で選びます。\r\n送信先: api.github.com、github.com、release-assets.githubusercontent.com。署名検証時は証明書発行元の失効情報を照会します。音声・本文・ファイル名・パス・APIキーは送りません。"
    IDS_UPDATE_CHECKING "更新情報を確認中です。文字起こしは続けられます。"
    IDS_UPDATE_AVAILABLE "新しい版があります。設定メニューから更新を取得できます。"
    IDS_UPDATE_CURRENT "更新情報を確認しました。この版より新しい公開版はありません。"
    IDS_UPDATE_UNAVAILABLE "更新を確認できませんでした。未公開・通信制限・オフライン等が考えられます。文字起こしは続けられます。"
    IDS_UPDATE_DOWNLOADING "更新を取得・署名検証中です。設定メニューから更新だけを取消せます。"
    IDS_UPDATE_READY "更新を準備しました。処理と保存を終え、設定メニューの「終了して更新」から進めます。"
    IDS_UPDATE_FAILED "更新の取得・検証・起動に失敗しました。アプリと保存結果は保持しています。更新を再確認してください。"
    IDS_UPDATE_CANCELLED "更新処理を取消しました。文字起こしと保存結果は保持しています。"
    IDS_UPDATE_GET_PROMPT "新しいKoeFudeを取得して署名を検証します。インストールは、準備後に「終了して更新」を選んで進めます。取得しますか？"
    IDS_UPDATE_CLOSE_PROMPT "KoeFudeを正常終了し、署名確認済みセットアップを開きます。通常の画面で更新してください。履歴・設定・モデルは保持します。続けますか？"
    IDS_UPDATE_BUSY "文字起こし・API・モデル準備・保存を終え、設定画面を閉じてから「終了して更新」を選んでください。実行中の処理は終了しません。"
    IDS_UPDATE_GET "更新を取得…"
    IDS_UPDATE_INSTALL "終了して更新…"
    IDS_UPDATE_PORTABLE "現在はポータブル版です。このフォルダーは変更せず、利用者専用の通常インストールを行います。"
END

