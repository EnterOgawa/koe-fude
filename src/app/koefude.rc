#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "speaker_text_strings.rcinc"
#include "version.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 RT_MANIFEST "koefude.manifest"
IDI_APP ICON "icons/koefude.ico"
IDI_ADD ICON "icons/add.ico"
IDI_SAVE ICON "icons/save.ico"
IDI_COPY ICON "icons/copy.ico"
IDI_CANCEL ICON "icons/cancel.ico"
IDI_CLEAR ICON "icons/clear.ico"
IDI_RENAME ICON "icons/rename.ico"

1 VERSIONINFO
FILEVERSION KOEFUDE_VERSION_NUMERIC
PRODUCTVERSION KOEFUDE_VERSION_NUMERIC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "EnterSystem"
            VALUE "FileDescription", "KoeFude ローカル文字起こし"
            VALUE "FileVersion", KOEFUDE_VERSION_STRING
            VALUE "InternalName", "koefude"
            VALUE "LegalCopyright", "Copyright (c) 2026 Shunji Ogawa"
            VALUE "OriginalFilename", "KoeFude.exe"
            VALUE "ProductName", "KoeFude"
            VALUE "ProductVersion", KOEFUDE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END

#include "ui_ja.rcinc"
#include "ui_en.rcinc"

