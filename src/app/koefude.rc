    IDS_API_BUSY "受付できません。履歴保存または進行中の操作が終わってから再操作してください。"
    IDS_API_FAILED "API操作に失敗しました。原文と前の採用結果を保持しています。"
    IDS_API_KEY_READY "登録済み（変更は適用、空白だけで適用すると削除）"
    IDS_API_KEY_MISSING "キー未設定"
    IDS_API_SAVE_FAILED "保存に失敗しました。同じ結果の再保存はAPIへ送信しません。"
    IDS_API_SAVED "API操作の結果を保存済み。候補と採用済み本文の出所を下の情報で確認できます。"
    IDS_API_ADOPTED "採用したAPI補正文（時刻・話者対応なし）"
    IDS_API_NOTICE "OpenAI / api.openai.com / 選択モデル / medium。本文中の氏名等も選択行の全文のまま送信対象です。API入力は明示opt-inしない限り学習に使われません。store:falseでも保存一切なしやZDRを保証しません。監視logは既定最大30日、prompt cacheは別途あり得ます。Pro契約と回答・料金・creditの一致は未確認。概算は実課金・税・換算を含まず、課金hard limitではありません。表面検査は意味品質保証ではありません。"
END

IDD_API_TEXT DIALOGEX 0, 0, 530, 365
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "APIで文章を改善"
FONT 9, "ＭＳ ゴシック"
BEGIN
    LTEXT "", IDC_API_SUMMARY, 8, 8, 514, 28
    LTEXT "確認した全文だけをOpenAIへ送信します。音声は送信しません。", -1, 8, 39, 514, 12
    CONTROL "", IDC_API_TABS, WC_TABCONTROL, WS_TABSTOP, 8, 58, 514, 224
    EDITTEXT IDC_API_PREVIEW, 14, 79, 502, 197, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_API_CANDIDATE, 14, 79, 502, 197, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_API_REPORT, 8, 288, 514, 25
    PUSHBUTTON "この全文を送信", IDC_API_SEND, 8, 320, 102, 22
    PUSHBUTTON "改善案を採用", IDC_API_ADOPT, 117, 320, 90, 22
    PUSHBUTTON "取消し", IDC_API_CANCEL, 214, 320, 64, 22
    PUSHBUTTON "その他…", IDC_API_MORE, 285, 320, 68, 22
    PUSHBUTTON "API設定…", IDC_API_SETTINGS_OPEN, 360, 320, 76, 22
    PUSHBUTTON "閉じる", IDCANCEL, 443, 320, 79, 22
END

IDD_API_SETTINGS DIALOGEX 0, 0, 450, 285
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "API文章改善の設定"
FONT 9, "ＭＳ ゴシック"
BEGIN
    LTEXT "行の「APIで文章を改善」で文字起こし全文をOpenAIへ送信します。", IDC_API_NOTICE_LABEL, 8, 8, 434, 23
    LTEXT "Secret key", IDC_API_KEY_LABEL, 8, 39, 76, 13
    EDITTEXT IDC_API_KEY, 88, 36, 354, 18, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "このWindowsユーザーに保存（新規登録時はOFF）", IDC_API_PERSIST, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 88, 60, 354, 14
    LTEXT "キー未設定", IDC_API_KEY_STATE, 88, 79, 354, 13
    LTEXT "利用モデル", IDC_API_MODEL_LABEL, 8, 103, 76, 13
    COMBOBOX IDC_API_MODEL, 88, 99, 354, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "単価（USD / 100万token）", IDC_API_PRICES_LABEL, 8, 126, 248, 13
    PUSHBUTTON "モデル・単価を更新", IDC_API_REFRESH, 290, 122, 152, 20
    CONTROL "モデルのStandard単価", IDC_API_PRICES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 146, 434, 48
    LTEXT "", IDC_API_METADATA, 8, 199, 434, 42
    LTEXT "", IDC_API_REPORT, 8, 240, 434, 12
    PUSHBUTTON "詳細…", IDC_API_DETAILS, 8, 253, 70, 22
    PUSHBUTTON "適用", IDC_API_SETTINGS_APPLY, 284, 253, 74, 22
    PUSHBUTTON "閉じる", IDCANCEL, 366, 253, 76, 22
END

