// ADR1354: 内容は現在のUI言語resourceから再設定します
IDD_SETTINGS DIALOGEX 0, 0, 590, 420
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "設定"
FONT 9, "ＭＳ ゴシック"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, WC_TABCONTROL, WS_TABSTOP, 8, 8, 574, 365
    LTEXT "", IDC_SETTINGS_UI_LABEL, 16, 40, 90, 16
    COMBOBOX IDC_SETTINGS_UI, 120, 40, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_SETTINGS_UPDATE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 80, 540, 20
    LTEXT "", IDC_SETTINGS_UPDATE_NOTE, 16, 108, 540, 72
    LTEXT "", IDC_MODEL_LABEL, 16, 40, 90, 16
    COMBOBOX IDC_ASR_MODEL, 120, 40, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_ASR_LABEL, 16, 76, 90, 16
    COMBOBOX IDC_ASR_PROFILE, 120, 76, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_SETTINGS_BACKEND_LABEL, 16, 110, 90, 16
    COMBOBOX IDC_BACKEND, 120, 110, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_SETTINGS_LANGUAGE_LABEL, 16, 145, 90, 16
    COMBOBOX IDC_LANGUAGE, 120, 145, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_SPEECH_FILTER, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 180, 480, 20
    CONTROL "", IDC_DIARIZE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 40, 480, 20
    LTEXT "", IDC_SETTINGS_COUNT_LABEL, 16, 76, 90, 16
    COMBOBOX IDC_COUNT, 120, 76, 400, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SETTINGS_METHOD_LABEL, 16, 110, 90, 16
    COMBOBOX IDC_SETTINGS_METHOD, 120, 110, 400, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_AUDIO_INFO, 16, 248, 552, 78
    PUSHBUTTON "", IDC_AUDIO_REFRESH, 16, 330, 210, 22
    PUSHBUTTON "", IDC_AUDIO_KEYS, 236, 330, 330, 22
    LTEXT "", IDC_SETTINGS_NOTE, 8, 382, 370, 26
    PUSHBUTTON "", IDC_SETTINGS_APPLY, 400, 382, 80, 24
    PUSHBUTTON "", IDCANCEL, 490, 382, 90, 24
END

IDD_RENAME DIALOGEX 0, 0, 360, 100
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "話者名を変更"
FONT 9, "ＭＳ ゴシック"
BEGIN
    COMBOBOX IDC_SPEAKER, 8, 12, 88, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_NAME, 104, 12, 248, 20, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "適用", IDC_RENAME, 184, 64, 80, 24
    PUSHBUTTON "閉じる", IDCANCEL, 272, 64, 80, 24
END

