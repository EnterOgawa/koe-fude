// ADR1402: 通常のWin32枠で非同期metadata取得を示し、同じ要求だけを取り消します
IDD_API_CATALOG_PROGRESS DIALOGEX 0, 0, 300, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "モデル情報の取得"
FONT 9, "ＭＳ ゴシック"
BEGIN
    LTEXT "モデル情報・単価を取得しています。", IDC_API_CATALOG_MESSAGE, 12, 14, 276, 18
    CONTROL "", IDC_API_CATALOG_PROGRESS, PROGRESS_CLASS, PBS_MARQUEE, 12, 42, 276, 12
    PUSHBUTTON "キャンセル", IDCANCEL, 216, 68, 72, 22
END

