IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Add audio…\tCtrl+O", IDC_OPEN
        MENUITEM "&Save transcript…\tCtrl+S", IDC_SAVE
        MENUITEM "&Transcribe again", IDC_RETRANSCRIBE
        MENUITEM "Improve text with &API", IDC_API_TEXT_OPEN
        MENUITEM "&Cancel", IDC_CANCEL
        MENUITEM SEPARATOR
        MENUITEM "Retry history storage", IDC_HISTORY_RETRY
        MENUITEM "E&xit", IDC_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy full text", IDC_COPY
        MENUITEM "Rename &speaker…", IDC_RENAME
        MENUITEM "&Remove selected history\tDelete", IDC_HISTORY_REMOVE
        MENUITEM "C&lear history", IDC_CLEAR
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Settings…", IDC_SETTINGS_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Check for &updates…", IDC_UPDATE_CHECK
        MENUITEM "Download update…", IDC_UPDATE_INSTALL
        MENUITEM "Cancel update", IDC_UPDATE_CANCEL
    END
END

STRINGTABLE
BEGIN
    IDS_UPDATE_STARTUP "Check for updates at startup (GitHub)"
    IDS_UPDATE_PRIVACY "Startup only checks public release information. You choose when to download and install.\r\nHosts: api.github.com, github.com, release-assets.githubusercontent.com. Signature verification may contact certificate authorities. Audio, text, names, paths and API keys are never sent."
    IDS_UPDATE_CHECKING "Checking updates. Transcription can continue."
    IDS_UPDATE_AVAILABLE "A newer version is available. Choose Download update in Settings."
    IDS_UPDATE_CURRENT "Checked successfully. No newer public version is available."
    IDS_UPDATE_UNAVAILABLE "Could not check updates. The release may be unpublished or the connection unavailable or limited. Transcription can continue."
    IDS_UPDATE_DOWNLOADING "Downloading and verifying the update. You can cancel just the update from Settings."
    IDS_UPDATE_READY "Update ready. Finish processing and saving, then choose Exit and update in Settings."
    IDS_UPDATE_FAILED "Update download, verification or launch failed. The app and saved results are retained. Check for updates again."
    IDS_UPDATE_CANCELLED "Update cancelled. Transcription and saved results are retained."
    IDS_UPDATE_GET_PROMPT "Download the newer KoeFude and verify its signature? Installation starts only after you later choose Exit and update."
    IDS_UPDATE_CLOSE_PROMPT "Close KoeFude normally and open the verified setup wizard? Continue in the setup window. History, settings and models are retained."
    IDS_UPDATE_BUSY "Finish transcription, API work, model preparation and saving, and close Settings before choosing Exit and update. Current work will continue."
    IDS_UPDATE_GET "Download update…"
    IDS_UPDATE_INSTALL "Exit and update…"
    IDS_UPDATE_PORTABLE "This is a portable copy. Its folder will be retained and a normal per-user installation will be opened."
END

